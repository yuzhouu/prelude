{
  "manifest_version": 3,
  "name": "今巡",
  "version": "1.0.0",
  "description": "每日想看的，都在这里",
  "permissions": [
    "bookmarks",
    "favicon",
    "search",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "auto-title-background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
