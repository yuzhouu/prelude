{
  "manifest_version": 3,
  "name": "开篇 · Prelude",
  "version": "1.0.0",
  "description": "一页初开，万事徐来。",
  "permissions": [
    "bookmarks",
    "favicon",
    "search",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "auto-title-background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
