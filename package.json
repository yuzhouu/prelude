{
  "name": "prelude",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:site": "vite build --config vite.pages.config.ts && node scripts/finalize-site.mjs",
    "preview:site": "vite preview --config vite.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/features/*/*.test.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm check && pnpm test",
    "check:store": "node scripts/check-release.mjs",
    "release:extension": "pnpm validate && pnpm build && pnpm check:store && node scripts/package-extension.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test:bookmark-drag": "node --test src/features/bookmarks/bookmark-drag.test.ts",
    "test:tab-drag": "node --test src/features/tabs/tab-drag.test.ts",
    "test:search": "node --test src/features/search/omnibox-model.test.ts",
    "test:shortcuts": "node --test src/features/shortcuts/shortcut-preferences.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.12",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
